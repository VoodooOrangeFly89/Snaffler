{
  "ClassifierRules": [
    {
      "RuleName": "WindowsSystem",
      "Description": "Exclude Windows system directories",
      "EnumerationScope": "DirectoryEnumeration",
      "MatchLocation": "DirectoryPath",
      "WordListType": "Contains",
      "WordList": [
        "\\Windows\\",
        "\\Program Files\\",
        "\\Program Files (x86)\\",
        "\\ProgramData\\Microsoft\\",
        "\\$Recycle.Bin\\",
        "\\System Volume Information\\"
      ],
      "MatchAction": "Discard",
      "Triage": "Black"
    },
    {
      "RuleName": "UserProfiles",
      "Description": "User profile directories",
      "EnumerationScope": "DirectoryEnumeration",
      "MatchLocation": "DirectoryPath",
      "WordListType": "Contains",
      "WordList": ["\\Users\\", "\\home\\"],
      "MatchAction": "Relay",
      "Triage": "Green"
    },
    {
      "RuleName": "InterestingDirs",
      "Description": "Directories likely to contain interesting data",
      "EnumerationScope": "DirectoryEnumeration",
      "MatchLocation": "DirectoryPath",
      "WordListType": "Contains",
      "WordList": [
        "backup",
        "config",
        "credential",
        "password",
        "secret",
        ".ssh",
        ".aws",
        ".kube"
      ],
      "MatchAction": "Relay",
      "Triage": "Yellow"
    }
  ]
}

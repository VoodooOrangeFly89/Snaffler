{
  "ClassifierRules": [
    {
      "RuleName": "DiscardNonFileShares",
      "Description": "Skips scanning inside shares ending with these words.",
      "EnumerationScope": "ShareEnumeration",
      "MatchLocation": "ShareName",
      "WordListType": "EndsWith",
      "WordList": ["print$", "ipc$"],
      "MatchAction": "Discard",
      "Triage": "Green"
    },
    {
      "RuleName": "KeepDollarShares",
      "Description": "Notifies the user that they can read C$ or ADMIN$ or something fun/noisy, but doesn't actually scan inside it.",
      "EnumerationScope": "ShareEnumeration",
      "MatchLocation": "ShareName",
      "WordListType": "EndsWith",
      "WordList": ["C$", "ADMIN$"],
      "MatchAction": "Snaffle",
      "Triage": "Black"
    },
    {
      "RuleName": "KeepSCCMShares",
      "Description": "Notifies the user that they can read SCCMContentLib$ so they can take CMLoot for a spin.",
      "EnumerationScope": "ShareEnumeration",
      "MatchLocation": "ShareName",
      "WordListType": "EndsWith",
      "WordList": ["SCCMContentLib$"],
      "MatchAction": "Snaffle",
      "Triage": "Yellow"
    }
  ]
}

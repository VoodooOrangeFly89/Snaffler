    {
      "RuleName": "RelayPhpByExtension",
      "Description": "Files with these extensions will be searched for php related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["php", "phtml", "inc", "php3", "php5", "php7"],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepPhpDbConnStrings",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation",
        "KeepDbConnStringPw"
      ]
    },
    {
      "RuleName": "KeepPerlDbConnStrings",
      "Description": "Files with contents matching these regexen are very interesting.",
      "EnumerationScope": "ContentsEnumeration",
      "MatchLocation": "FileContentAsString",
      "WordListType": "Regex",
      "WordList": ["DBI\\-\\>connect\\("],
      "MatchAction": "Snaffle",
      "Triage": "Red"
    },
    {
      "RuleName": "RelayPerlByExtension",
      "Description": "Files with these extensions will be searched for Perl related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["pl"],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepPerlDbConnStrings",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation",
        "KeepDbConnStringPw"
      ]
    },
    {
      "RuleName": "KeepPSHistoryByName",
      "Description": "Files with these exact names will be searched for PowerShell related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileName",
      "WordListType": "Exact",
      "WordList": [
        "ConsoleHost_history.txt",
        "Visual Studio Code Host_history.txt"
      ],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepPsCredentials",
        "KeepCmdCredentials",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation",
        "KeepDbConnStringPw"
      ]
    },
    {
      "RuleName": "KeepPsCredentials",
      "Description": "Files with contents matching these regexen are very interesting.",
      "EnumerationScope": "ContentsEnumeration",
      "MatchLocation": "FileContentAsString",
      "WordListType": "Regex",
      "WordList": [
        "-SecureString",
        "-AsPlainText",
        "\\[Net.NetworkCredential\\]::new\\("
      ],
      "MatchAction": "Snaffle",
      "Triage": "Red"
    },
    {
      "RuleName": "RelayPsByExtension",
      "Description": "Files with these extensions will be searched for PowerShell related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["psd1", "psm1", "ps1"],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepPsCredentials",
        "KeepCmdCredentials",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation",
        "KeepDbConnStringPw"
      ]
    },
    {
      "RuleName": "KeepPyDbConnStrings",
      "Description": "Files with contents matching these regexen are very interesting.",
      "EnumerationScope": "ContentsEnumeration",
      "MatchLocation": "FileContentAsString",
      "WordListType": "Regex",
      "WordList": [
        "mysql\\.connector\\.connect\\(",
        "psycopg2\\.connect\\("
      ],
      "MatchAction": "Snaffle",
      "Triage": "Red"
    },
    {
      "RuleName": "RelayPythonByExtension",
      "Description": "Files with these extensions will be searched for python related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["py"],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepPyDbConnStrings",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",

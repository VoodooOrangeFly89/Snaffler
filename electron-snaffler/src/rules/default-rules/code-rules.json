    },
    {
      "RuleName": "KeepRubyDbConnStrings",
      "Description": "Files with contents matching these regexen are very interesting.",
      "EnumerationScope": "ContentsEnumeration",
      "MatchLocation": "FileContentAsString",
      "WordListType": "Regex",
      "WordList": ["DBI\\.connect\\("],
      "MatchAction": "Snaffle",
      "Triage": "Red"
    },
    {
      "RuleName": "RelayRubyByExtension",
      "Description": "Files with these extensions will be searched for Ruby related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["rb"],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepRubyDbConnStrings",
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation",
        "KeepDbConnStringPw"
      ]
    },
    {
      "RuleName": "RelayShellScriptByExtension",
      "Description": "Files with these extensions will be searched for Bash related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": [
        "netrc", "exports", "functions", "extra", "npmrc",
        "env", "bashrc", "profile", "zshrc", "bash_history",
        "zsh_history", "sh_history", "zhistory", "irb_history", "sh"
      ],
      "MatchAction": "Relay",
      "Triage": "Green",
      "RelayTargets": [
        "KeepAwsKeysInCode",
        "KeepInlinePrivateKey",
        "KeepPassOrKeyInCode",
        "KeepSlackTokensInCode",
        "KeepSqlAccountCreation"
      ]
    },
    {
      "RuleName": "RelayVBScriptByExtension",
      "Description": "Files with these extensions will be searched for cmd.exe/batch file related strings.",
      "EnumerationScope": "FileEnumeration",
      "MatchLocation": "FileExtension",
      "WordListType": "Exact",
      "WordList": ["vbs", "vbe", "wsf", "wsc", "hta"],
